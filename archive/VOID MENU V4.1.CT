  <UserdefinedSymbols/>
  <LuaScript>getMainForm().Caption = "VOID MENU"

local gameProcess = "DyingLightGame.exe"

function attachToGame()
    while getProcessIDFromProcessName(gameProcess) == nil do
        sleep(1000)
    end
    openProcess(gameProcess)
end

createThread(attachToGame)
</LuaScript>
