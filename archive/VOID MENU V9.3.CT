alloc(MessageText,999,2449cec0000)
registersymbol(MessageText)
alloc(MessageUIEditBox,20)
registersymbol(MessageUIEditBox)

aobscanmodule(INJECT,gamedll_x64_rwdi.dll,48 39 75 40 74 4D)
alloc(newmem,$1000,INJECT)
alloc(getNewHudMessageElement,20)
registersymbol(getNewHudMessageElement)
label(code)
label(return)

newmem:
  mov [getNewHudMessageElement],rbp
code:
  cmp [rbp+40],rsi
  je gamedll_x64_rwdi.dll+57A76C
  jmp return

INJECT:
  jmp newmem
  nop
return:
registersymbol(INJECT)

{$lua}

SendMessageCallEnable=[[
alloc(SendMessageCall,300)
createThread(SendMessageCall)

SendMessageCall:
mov rax,MessageText
mov [MessageUIEditBox],rax
mov rax,MessageUIEditBox
mov [rax+8],500
sub rsp,78
mov rcx,gamedll_x64_rwdi.dll+1C0E2F8
mov rcx,[rcx]
mov rcx,[rcx+5a0]
mov rcx,[rcx+b0]
mov r9,0
mov rdx,MessageUIEditBox
call gamedll_x64_rwdi.dll+47BBC0
add rsp,78
ret
dealloc(SendMessageCall)
]]

ChatWindow.show()
ChatWindow_OutputWindow.clear()

function readWideString(StrAddr)
  local CheckStr=readSmallInteger(StrAddr)
  local str={}
  local i=0
  while(CheckStr~=0)
  do
  CheckStr=readSmallInteger(StrAddr+i-1)
  str[i+1]=readBytes(StrAddr+i)
  i=i+1
  end

  local WideString=byteTableToWideString(str)
  return WideString
end

function writeWideString(WideStringAddr,WideString)
  function table_leng(t)
  local leng=0
  for k, v in pairs(t) do
    leng=leng+1
  end
  return leng;
  end
  local WideStringTable=wideStringToByteTable(WideString)
  for i=1,table_leng(WideStringTable) do
      writeBytes(WideStringAddr+i-1,WideStringTable[i])
  end
  writeSmallInteger(WideStringAddr+table_leng(WideStringTable),0x0000)
end

function ChatWindow_InputWindowChange(sender)
writeWideString(getAddress("MessageText"),ChatWindow_InputWindow.Lines.text)
end

function ChatWindow_InputWindowKeyDown(sender, key)
if key==13 and readSmallInteger("MessageText")~=0 then
writeWideString(getAddress("MessageText"),ChatWindow_InputWindow.Lines.text)
autoAssemble(SendMessageCallEnable)
ChatWindow_InputWindow.clear()
end
end

function ChatWindow_ButtonSendClick(sender)
if readSmallInteger("MessageText")~=0 then
writeWideString(getAddress("MessageText"),ChatWindow_InputWindow.Lines.text)
autoAssemble(SendMessageCallEnable)
ChatWindow_InputWindow.clear()
end
end

function ChatWindow_ThemeColorSelectionChanged(sender)
if ChatWindow_ThemeColor.ItemIndex==1 then
ChatWindow.color=0xD6E4B6
ChatWindow_InputWindow.color=0xF9FBF4
ChatWindow_OutputWindow.color=0xE3EDCD
else
if ChatWindow_ThemeColor.ItemIndex==2 then
ChatWindow.color=0xA8BDF0
ChatWindow_InputWindow.color=0xcbe8f3
ChatWindow_OutputWindow.color=0xb4c6f2
else
ChatWindow.color=clDefault
ChatWindow_InputWindow.color=clDefault
ChatWindow_OutputWindow.color=clDefault
end
end
end

function ChatWindow_TransitChange(sender)
HudMessageElement=ChatWindow_Transit.text
ChatWindow_OutputWindow.append(readWideString(readQword(readQword(readQword(readQword(HudMessageElement+0x38)+0x18)+0x378)+0x30)))
end

function RefreshMessage()
  if readQword("getNewHudMessageElement") then
  if readQword("getNewHudMessageElement")~=0 then
     local NewHookPoint=readQword("getNewHudMessageElement")
    if NewHookPoint ~= OldHookPoint then
      local getTime=os.date("%H:%M:%S")
      ChatWindow_OutputWindow.append("["..getTime.."] "..readWideString(readQword(readQword(readQword(readQword(readQword("getNewHudMessageElement")+0x38)+0x18)+0x378)+0x30)))
      OldHookPoint=NewHookPoint
    end
  end
  end
end

DetectMessageTimer=createTimer(getMainForm)
DetectMessageTimer.Interval=10
DetectMessageTimer.OnTimer=RefreshMessage


