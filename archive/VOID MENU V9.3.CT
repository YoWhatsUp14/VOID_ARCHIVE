                      <VariableType>4 Bytes</VariableType>
                      <Address>WvSpawned</Address>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337311084</ID>
                      <Description>"DIAG: instance build ok (1 = id resolved through registry)"</Description>
                      <VariableType>4 Bytes</VariableType>
                      <Address>WvBuildOK</Address>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337311085</ID>
                      <Description>"DIAG: instance desc ptr (should equal clone desc ptr)"</Description>
                      <ShowAsHex>1</ShowAsHex>
                      <VariableType>8 Bytes</VariableType>
