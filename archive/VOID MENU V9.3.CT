              <AssemblerScript>[ENABLE]
aobscanmodule(FrHook,gamedll_x64_rwdi.dll,44 38 76 28 74 48 BA 01 00 00 00 48 8B CE E8 ?? ?? ?? ?? 48 8B 4E 70 3B 41 28)
alloc(FrMem,$100,FrHook)
label(FrCode)
label(FrCont)
label(FrHunter)
label(FrDo)
label(FrMode)
registersymbol(FrHook)
registersymbol(FrMode)

FrMem:
FrMode:
  dd 0

FrCode:
  cmp byte ptr [rsi+28],0
  je FrHook+4E
  mov eax,[FrMode]
  test eax,eax
  je FrCont
  cmp dword ptr [rsi+230],3
  jne FrCont
  mov dword ptr [FrMode],0
  cmp eax,1
  jne FrHunter
  mov dword ptr [rsi+240],5
  mov dword ptr [rsi+238],1
  jmp FrDo
FrHunter:
  mov dword ptr [rsi+238],2
FrDo:
  mov edx,4
  mov rcx,rsi
  call FrHook+990
  jmp FrHook+640
FrCont:
  jmp FrHook+6

FrHook:
  jmp FrCode
  nop

[DISABLE]
FrHook:
  db 44 38 76 28 74 48
