alloc(GetPtrMem,$1000,SetHiveVeinsColor)

label(red)
label(orange)
label(yellow)
label(green)
label(cyan)
label(blue)
label(purple)
label(white)

label(o_code)
label(code)
alloc(sleepTime,4)

alloc(HiveC_R,8)
alloc(HiveC_G,8)
alloc(HiveC_B,8)
registersymbol(HiveC_R)
registersymbol(HiveC_G)
registersymbol(HiveC_B)
HiveC_R:
  db 00 00 7F C3
HiveC_G:
  db 00 00 80 3F
HiveC_B:
  db 00 00 80 3F

GetPtrMem:
  cmp rcx,00000000
  jne o_code
  cmp rbp,00000000
  jne o_code
  cmp r12,00000000
  jne o_code
  cmp [sleepTime],50
  jbe code
  mov [sleepTime],0
//-------------------------
  cmp [HiveC_R],(float)-255
  jz red
  cmp [HiveC_G],(float)-128
  jz cyan
  cmp [HiveC_G],(float)-255
  jz blue
  cmp [HiveC_B],(float)-155
  jz purple
  cmp [HiveC_B],(float)-128
  jz white

red:
  cmp [HiveC_G],(float)0
  jz orange
  cmp [HiveC_G],(float)-165
  jz yellow
  cmp [HiveC_G],(float)-255
  jz green
  mov [HiveC_R],(float)-255
  mov [HiveC_G],(float)0
  mov [HiveC_B],(float)0
  jmp code
orange:
  mov [HiveC_R],(float)-255
  mov [HiveC_G],(float)-165
  mov [HiveC_B],(float)0
  jmp code
yellow:
  mov [HiveC_R],(float)-255
  mov [HiveC_G],(float)-255
  mov [HiveC_B],(float)0
  jmp code
green:
  mov [HiveC_R],(float)0
  mov [HiveC_G],(float)-128
  mov [HiveC_B],(float)0
  jmp code
cyan:
  mov [HiveC_R],(float)0
  mov [HiveC_G],(float)-255
  mov [HiveC_B],(float)-255
  jmp code
blue:
  mov [HiveC_R],(float)0
  mov [HiveC_G],(float)0
  mov [HiveC_B],(float)-155
  jmp code
purple:
  mov [HiveC_R],(float)-128
  mov [HiveC_G],(float)0
  mov [HiveC_B],(float)-128
  jmp code
white:
  mov [HiveC_R],(float)-255
  mov [HiveC_G],(float)1
  mov [HiveC_B],(float)1
  jmp code

code:
  add [sleepTime],1
  //--R
  mov eax,[HiveC_R]
  mov [rbx+rcx*8+28],eax
  //--G
  mov eax,[HiveC_G]
  mov [rbx+rcx*8+2C],eax
  //--B
  mov eax,[HiveC_B]
  mov [rbx+rcx*8+30],eax
  //--A Default 0.587
  mov eax,[rdi+0C]
  mov [rbx+rcx*8+34],eax
  jmp SetCodeExit+2
o_code:
  mov [rbx+rcx*8+28],eax
  mov eax,[rdi+04]
  jmp SetHiveVeinsColor+7

SetHiveVeinsColor:
  jmp GetPtrMem
  nop 2

[DISABLE]
SetHiveVeinsColor:
  db 89 44 CB 28 8B 47 04
