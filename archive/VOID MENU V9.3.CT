                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337311086</ID>
                      <Description>"DIAG: instance +90 (id field after build)"</Description>
                      <ShowAsHex>1</ShowAsHex>
                      <VariableType>4 Bytes</VariableType>
                      <Address>WvInst90</Address>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337311087</ID>
                      <Description>"DIAG: igs mode that worked (0 player+28, 1 level+10)"</Description>
                      <VariableType>4 Bytes</VariableType>
                      <Address>WvIgsMode</Address>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337311088</ID>
