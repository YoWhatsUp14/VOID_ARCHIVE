  Patched out so the accumulator never advances. }
[ENABLE]
aobscanmodule(BX_NoTimeLimit,gamedll_x64_rwdi.dll,F3 0F 58 86 C8 25 00 00 F3 0F 11 86 C8 25 00 00 44 38 76 28)
assert(BX_NoTimeLimit,F3 0F 58 86)
registersymbol(BX_NoTimeLimit)
BX_NoTimeLimit+8:
  db 90 90 90 90 90 90 90 90

[DISABLE]
BX_NoTimeLimit+8:
  db F3 0F 11 86 C8 25 00 00
unregistersymbol(BX_NoTimeLimit)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>9000026</ID>
              <Description>"Death Limit Override"</Description>
              <Options moHideChildren="1"/>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Human Team Death Limit Override
  The match sums a per-player stat over human-side players and compares it with
  settings+28.  When it reaches that value the hunter wins (result 2).
  This replaces that comparison with BX_LivesLimit (0 = vanilla).
  Original: mov rcx,[rsi+70] / cmp eax,[rcx+28]  (48 8B 4E 70 3B 41 28) }
[ENABLE]
aobscanmodule(BX_LivesHook,gamedll_x64_rwdi.dll,48 8B 4E 70 3B 41 28 7C ? 48 8B 0D ? ? ? ? C7 86 38 02 00 00 02 00 00 00)
assert(BX_LivesHook,48 8B 4E 70 3B 41 28)
alloc(BX_LivesMem,$100,BX_LivesHook)
label(BX_LivesVanilla)
label(BX_LivesRet)
label(BX_LivesLimit)
registersymbol(BX_LivesHook)
registersymbol(BX_LivesLimit)

BX_LivesMem:
  mov rcx,[rsi+70]
  mov edx,[BX_LivesLimit]
  test edx,edx
  jz BX_LivesVanilla
  cmp eax,edx
  jmp BX_LivesRet
BX_LivesVanilla:
  cmp eax,[rcx+28]
  jmp BX_LivesRet

BX_LivesMem+80:
BX_LivesLimit:
  dd 0

BX_LivesHook:
  jmp BX_LivesMem
  nop 2
BX_LivesRet:

[DISABLE]
BX_LivesHook:
  db 48 8B 4E 70 3B 41 28
unregistersymbol(BX_LivesHook)
unregistersymbol(BX_LivesLimit)
dealloc(BX_LivesMem)
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>9000020</ID>
                  <Description>"Deaths allowed before hunter wins (0 = vanilla, 9999 = effectively infinite)"</Description>
                  <VariableType>4 Bytes</VariableType>
                  <Address>BX_LivesLimit</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>1337311047</ID>
              <Description>"Crasher"</Description>
              <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
              <LastState/>
              <Color>0000FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
// CUSTOM WEAPON v5.  STATIC ANALYSIS ONLY, NOT RUN LIVE.  All numbers here are hex (CE asm default).
// Changes vs v4 (all found in IDA, gamedll RVAs):
//  - Instance is now built the way the game builds one from an item id: 6F27E0 ctor, then 6F9DB0(0, id pointer, inst).
//    6F9DB0 looks the id up in the registry tree (root = [sub_1806F4A20()+68], same tree Lua edits), then 6F9A60
//    runs 6F3350 which resolves the desc by id, builds the embedded object and fills the instance. v4 skipped that
//    and called 745130 directly, so the instance was never bound to the id.
//  - Spawn return value is now checked. Null return = stage 8 (v4 counted it as spawned).
//  - If spawn with igs = player+28 returns null, retry once with igs = IGSObject::GetLevel(player+28)+10
//    (the form the game's own drop code 1806E32B0 uses). WvIgsMode shows which one worked.
//  - Diagnostics: WvBuildOK, WvInstDesc, WvInst90, WvNullCount, WvIgsMode.
//  46EAD0  per-frame virtual update (game thread). Hooked at entry.
//  443530  GetLocalPlayer(G), G = [gamedll+1C16348]
//  6F27E0  ItemInstance ctor     6F9DB0  build instance from id (a1 unused, rdx = int* id, r8 = inst)
//  6FADF0  world item spawner(inst, igs, up, pos, fwd, -1, -1, 1)
assert(gamedll_x64_rwdi.dll+46EAD0,48 8B C4 41 57 48 81 EC 10 01 00 00)
alloc(WvBlk,2000,gamedll_x64_rwdi.dll+46EAD0)
alloc(WvInstBuf,100)
label(WvHook)
label(WvRun)
label(WvAfterPrep)
label(WvErrPrep)
label(WvErrBuild)
label(WvNotReady)
label(WvNoPlayer)
label(WvLoop)
label(WvOk1)
label(WvOk2)
label(WvHaveIgs)
label(WvSpawnOk)
label(WvNull)
label(WvDone)
label(WvOrig)
label(WvReq)
label(WvState)
label(WvStage)
label(WvSrcId)
label(WvCount)
label(WvDist)
label(WvLift)
label(WvSpacing)
label(WvHalf)
label(WvNewId)
label(WvNewCount)
label(WvSpawned)
label(WvNode)
label(WvDescNew)
label(WvArrNew)
label(WvLastObj)
label(WvBuildOK)
label(WvInstDesc)
label(WvInst90)
label(WvNullCount)
label(WvIgsMode)
label(WvIgs)
label(WvGetLevel)
label(WvObjPos)
label(WvNoPos)
label(WvPlyPos)
label(WvPlyOK)
label(WvUseEng)
label(WvSkipEng)
label(WvNoPost)
label(WvPost)
registersymbol(WvPost)
registersymbol(WvObjPos)
registersymbol(WvPlyPos)
registersymbol(WvPlyOK)
registersymbol(WvUseEng)
registersymbol(WvBlk)
registersymbol(WvInstBuf)
registersymbol(WvReq)
registersymbol(WvState)
registersymbol(WvStage)
registersymbol(WvSrcId)
registersymbol(WvCount)
registersymbol(WvDist)
registersymbol(WvLift)
registersymbol(WvSpacing)
registersymbol(WvNewId)
registersymbol(WvNewCount)
registersymbol(WvSpawned)
registersymbol(WvNode)
registersymbol(WvDescNew)
registersymbol(WvArrNew)
registersymbol(WvLastObj)
registersymbol(WvBuildOK)
registersymbol(WvInstDesc)
registersymbol(WvInst90)
registersymbol(WvNullCount)
registersymbol(WvIgsMode)
registersymbol(WvIgs)
registersymbol(WvGetLevel)

WvBlk:
WvHook:
  cmp dword ptr [WvReq],0
  jne WvRun
  cmp dword ptr [WvState],1
  jne WvOrig
WvRun:
  push rax
  push rcx
  push rdx
  push rbx
  push rbp
  push rsi
  push rdi
  push r8
  push r9
  push r10
  push r11
  push r12
  push r13
  push r14
  push r15
  pushfq
  mov rbp,rsp
  sub rsp,300
  and rsp,FFFFFFFFFFFFFFF0
  fxsave [rsp+80]
  // frame: [rsp+0..7F] outgoing args, [rsp+80..27F] fxsave, [rsp+280] up, [rsp+290] pos, [rsp+2A0] fwd, [rsp+2B0] side

  // ---- stage A: publish registered desc + build instance from its id (game thread) ----
  cmp dword ptr [WvState],1
  jne WvAfterPrep
  mov rax,[WvNode]
  test rax,rax
  je WvErrPrep
  mov rcx,[WvArrNew]
  test rcx,rcx
  je WvErrPrep
  mov rdx,[WvDescNew]
  test rdx,rdx
  je WvErrPrep
  mov [rax-18],rcx
  mov ecx,[WvNewCount]
  mov [rax-10],ecx
  lea rcx,[WvInstBuf]
  call gamedll_x64_rwdi.dll+6F27E0
  xor ecx,ecx
  lea rdx,[WvNewId]
  lea r8,[WvInstBuf]
  call gamedll_x64_rwdi.dll+6F9DB0
  movzx eax,al
  mov [WvBuildOK],eax
  test eax,eax
  je WvErrBuild
  mov rax,[WvInstBuf+20]
  mov [WvInstDesc],rax
  mov rax,[WvDescNew]
  mov [WvInstBuf+20],rax
  mov eax,[WvInstBuf+90]
  mov [WvInst90],eax
  mov dword ptr [WvState],2
  mov dword ptr [WvStage],4
  jmp WvAfterPrep
WvErrPrep:
  mov dword ptr [WvState],0
  mov dword ptr [WvStage],2
  mov dword ptr [WvReq],0
  jmp WvDone
WvErrBuild:
  mov dword ptr [WvState],0
  mov dword ptr [WvStage],3
  mov dword ptr [WvReq],0
  jmp WvDone

  // ---- stage B: spawn ----
WvAfterPrep:
  cmp dword ptr [WvReq],0
  je WvDone
  cmp dword ptr [WvState],2
  jne WvNotReady
  mov rcx,[gamedll_x64_rwdi.dll+1C16348]
  test rcx,rcx
  je WvNoPlayer
  call gamedll_x64_rwdi.dll+443530
  test rax,rax
  je WvNoPlayer
  mov r12,rax
  mov rax,[r12+8]
  test rax,rax
  je WvNoPlayer
  lea r14,[rax+118]
  // fwd = column 0
  movss xmm0,[r14]
  movss [rsp+2A0],xmm0
  movss xmm0,[r14+10]
  movss [rsp+2A4],xmm0
  movss xmm0,[r14+20]
  movss [rsp+2A8],xmm0
  mov dword ptr [rsp+2AC],0
  // up = column 1
  movss xmm0,[r14+4]
  movss [rsp+280],xmm0
  movss xmm0,[r14+14]
  movss [rsp+284],xmm0
  movss xmm0,[r14+24]
  movss [rsp+288],xmm0
  mov dword ptr [rsp+28C],0
  // side = column 2
  movss xmm0,[r14+8]
  movss [rsp+2B0],xmm0
  movss xmm0,[r14+18]
  movss [rsp+2B4],xmm0
  movss xmm0,[r14+28]
  movss [rsp+2B8],xmm0
  mov dword ptr [rsp+2BC],0
  // base position: player+808 by default, engine GetPosition (vt+270) and GetForward (vt+B8) override it
  mov eax,[r12+808]
  mov [WvPlyPos],eax
  mov eax,[r12+80C]
  mov [WvPlyPos+4],eax
  mov eax,[r12+810]
  mov [WvPlyPos+8],eax
  mov dword ptr [WvPlyOK],0
  cmp dword ptr [WvUseEng],0
  je WvSkipEng
  mov rcx,r12
  mov rax,[rcx]
  lea rdx,[rsp+2C0]
  call qword ptr [rax+270]
  test rax,rax
  je WvSkipEng
  movss xmm0,[rax]
  movss [WvPlyPos],xmm0
  movss xmm0,[rax+4]
  movss [WvPlyPos+4],xmm0
  movss xmm0,[rax+8]
  movss [WvPlyPos+8],xmm0
  mov dword ptr [WvPlyOK],1
  mov rcx,r12
  mov rax,[rcx]
  lea rdx,[rsp+2D0]
  call qword ptr [rax+0B8]
  test rax,rax
  je WvSkipEng
  movss xmm0,[rax]
  movss [rsp+2A0],xmm0
  movss xmm0,[rax+4]
  movss [rsp+2A4],xmm0
  movss xmm0,[rax+8]
  movss [rsp+2A8],xmm0
  mov dword ptr [WvPlyOK],2
WvSkipEng:
  // up = world Y, side = cross(up, fwd).  The matrix column I used for up in v4/v5 held the player position.
  mov dword ptr [rsp+280],0
  mov dword ptr [rsp+284],3F800000
  mov dword ptr [rsp+288],0
  mov dword ptr [rsp+28C],0
  movss xmm0,[rsp+2A8]
  movss [rsp+2B0],xmm0
  mov dword ptr [rsp+2B4],0
  xorps xmm1,xmm1
  subss xmm1,[rsp+2A0]
  movss [rsp+2B8],xmm1
  mov dword ptr [rsp+2BC],0
  mov r13d,[WvCount]
  cmp r13d,1
  jge WvOk1
  mov r13d,1
WvOk1:
  cmp r13d,40
  jle WvOk2
  mov r13d,40
WvOk2:
  xor ebx,ebx
WvLoop:
  // side offset = (2i-(n-1)) * spacing * 0.5
  mov eax,ebx
  add eax,eax
  lea edx,[r13-1]
  sub eax,edx
  cvtsi2ss xmm3,eax
  mulss xmm3,[WvSpacing]
  mulss xmm3,[WvHalf]
  movss xmm4,[WvDist]
  movss xmm5,[WvLift]
  // pos = player.pos + fwd*dist + up*lift + side*off
  movss xmm0,[WvPlyPos]
  movss xmm1,[rsp+2A0]
  mulss xmm1,xmm4
  addss xmm0,xmm1
  movss xmm1,[rsp+280]
  mulss xmm1,xmm5
  addss xmm0,xmm1
  movss xmm1,[rsp+2B0]
  mulss xmm1,xmm3
  addss xmm0,xmm1
  movss [rsp+290],xmm0
  movss xmm0,[WvPlyPos+4]
  movss xmm1,[rsp+2A4]
  mulss xmm1,xmm4
  addss xmm0,xmm1
  movss xmm1,[rsp+284]
  mulss xmm1,xmm5
  addss xmm0,xmm1
  movss xmm1,[rsp+2B4]
  mulss xmm1,xmm3
  addss xmm0,xmm1
  movss [rsp+294],xmm0
  movss xmm0,[WvPlyPos+8]
  movss xmm1,[rsp+2A8]
  mulss xmm1,xmm4
  addss xmm0,xmm1
  movss xmm1,[rsp+288]
  mulss xmm1,xmm5
  addss xmm0,xmm1
  movss xmm1,[rsp+2B8]
  mulss xmm1,xmm3
  addss xmm0,xmm1
  movss [rsp+298],xmm0
  mov dword ptr [rsp+29C],0
  // sub_1806FADF0(inst, igs, up, pos, fwd, -1, -1, 1)
  lea rcx,[WvInstBuf]
  mov rdx,[WvIgs]
  test rdx,rdx
  jne WvHaveIgs
  lea rdx,[r12+28]
WvHaveIgs:
  lea r8,[rsp+280]
  lea r9,[rsp+290]
  lea rax,[rsp+2A0]
  mov [rsp+20],rax
  mov dword ptr [rsp+28],FFFFFFFF
  mov dword ptr [rsp+30],FFFFFFFF
  mov dword ptr [rsp+38],1
  call gamedll_x64_rwdi.dll+6FADF0
  mov [WvLastObj],rax
  test rax,rax
  jne WvSpawnOk
  // null return: retry once with the level igs object
  cmp dword ptr [WvIgsMode],0
  jne WvNull
  mov rax,[WvGetLevel]
  test rax,rax
  je WvNull
  lea rcx,[r12+28]
  call rax
  test rax,rax
  je WvNull
  add rax,10
  mov [WvIgs],rax
  mov dword ptr [WvIgsMode],1
  jmp WvLoop
WvSpawnOk:
  // same follow-up the game's own drop code (1806E32B0) runs on the new object: vt+428(obj, level igs), vt+438(obj, 0.0)
  cmp dword ptr [WvPost],0
  je WvNoPost
  mov rax,[WvGetLevel]
  test rax,rax
  je WvNoPost
  lea rcx,[r12+28]
  call rax
  test rax,rax
  je WvNoPost
  add rax,10
  mov rdx,rax
  mov rcx,[WvLastObj]
  mov r8,[rcx]
  call qword ptr [r8+428]
  mov rcx,[WvLastObj]
  mov rdx,[rcx]
  xorps xmm1,xmm1
  call qword ptr [rdx+438]
WvNoPost:
  // record where the object actually is (vt+270 = GetPosition, same call the game uses)
  mov rcx,[WvLastObj]
  mov rax,[rcx]
  lea rdx,[rsp+2C0]
  call qword ptr [rax+270]
  test rax,rax
  je WvNoPos
  movss xmm0,[rax]
  movss [WvObjPos],xmm0
  movss xmm0,[rax+4]
  movss [WvObjPos+4],xmm0
  movss xmm0,[rax+8]
  movss [WvObjPos+8],xmm0
WvNoPos:
  inc dword ptr [WvSpawned]
  inc ebx
  cmp ebx,r13d
  jl WvLoop
  mov dword ptr [WvStage],7
  mov dword ptr [WvReq],0
  jmp WvDone
WvNull:
  inc dword ptr [WvNullCount]
  mov dword ptr [WvStage],8
  mov dword ptr [WvReq],0
  jmp WvDone
WvNotReady:
  mov dword ptr [WvStage],5
  mov dword ptr [WvReq],0
  jmp WvDone
WvNoPlayer:
  mov dword ptr [WvStage],6
  mov dword ptr [WvReq],0
WvDone:
  fxrstor [rsp+80]
  mov rsp,rbp
  popfq
  pop r15
  pop r14
  pop r13
  pop r12
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdi
  pop rsi
  pop rbp
  pop rbx
  pop rdx
  pop rcx
  pop rax
WvOrig:
  mov rax,rsp
  push r15
  sub rsp,110
  jmp gamedll_x64_rwdi.dll+46EADC

WvReq:
  dd 0
WvState:
  dd 0
WvStage:
  dd 0
WvSrcId:
  dd 0
WvCount:
  dd 1
WvDist:
  dd (float)2.0
WvLift:
  dd (float)0.6
WvSpacing:
  dd (float)0.5
WvHalf:
  dd (float)0.5
WvNewId:
  dd 0
WvNewCount:
  dd 0
WvSpawned:
  dd 0
WvBuildOK:
  dd 0
WvInst90:
  dd 0
WvNullCount:
  dd 0
WvIgsMode:
  dd 0
WvNode:
  dq 0
WvDescNew:
  dq 0
WvArrNew:
  dq 0
WvLastObj:
  dq 0
WvInstDesc:
  dq 0
WvIgs:
  dq 0
WvGetLevel:
  dq 0
WvObjPos:
  dd 0
  dd 0
  dd 0
  dd 0
WvPlyPos:
  dd 0
  dd 0
  dd 0
  dd 0
WvPlyOK:
  dd 0
WvUseEng:
  dd 1
WvPost:
  dd 1

gamedll_x64_rwdi.dll+46EAD0:
  jmp WvHook
  nop 7

[DISABLE]
gamedll_x64_rwdi.dll+46EAD0:
  db 48 8B C4 41 57 48 81 EC 10 01 00 00
unregistersymbol(WvBlk)
unregistersymbol(WvInstBuf)
unregistersymbol(WvReq)
unregistersymbol(WvState)
unregistersymbol(WvStage)
unregistersymbol(WvSrcId)
unregistersymbol(WvCount)
unregistersymbol(WvDist)
unregistersymbol(WvLift)
unregistersymbol(WvSpacing)
unregistersymbol(WvNewId)
unregistersymbol(WvNewCount)
unregistersymbol(WvSpawned)
unregistersymbol(WvNode)
unregistersymbol(WvDescNew)
unregistersymbol(WvArrNew)
unregistersymbol(WvLastObj)
unregistersymbol(WvBuildOK)
unregistersymbol(WvInstDesc)
unregistersymbol(WvInst90)
unregistersymbol(WvNullCount)
unregistersymbol(WvIgsMode)
unregistersymbol(WvIgs)
unregistersymbol(WvGetLevel)
unregistersymbol(WvObjPos)
unregistersymbol(WvPlyPos)
unregistersymbol(WvPlyOK)
unregistersymbol(WvUseEng)
unregistersymbol(WvPost)
</AssemblerScript>
