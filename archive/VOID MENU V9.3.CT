local MOD = 'gamedll_x64_rwdi.dll'
local FIREARM_VT = 0x1554F30
local DESC_SIZE = 0x750
local GETLEVEL_IAT = 0x137B220

local function G(rva) return getAddress(MOD) + rva end

local function descType(d)
  return ((readInteger(d + 0x78) or 0) &gt;&gt; 8) &amp; 0xFFF
end

local SW = {
  [0xE]=1, [0x19]=1, [0x1A]=1, [0x1B]=1,
  [0x1C]=1, [0x1D]=1, [0x1E]=1, [0x29]=1,
  [0x2B]=1, [0x2C]=1, [0x2E]=1, [0x75]=1,
  [0x76]=1, [0x78]=1, [0x7B]=1
}

local function gmalloc(sz)
  local fp = readQword(G(0x137A3D8))
  local r
  if fp and fp ~= 0 then r = executeCodeEx(0, 5000, fp, sz) end
  if not r or r == 0 then
    print('v5: game malloc call failed, falling back to CE heap (ok, but leaks at exit)')
    r = allocateMemory(sz)
  end
  return r
end

local function findNode(key)
  local n = readQword(G(0x1D0B358))
  local best, g = nil, 0
  while n and n ~= 0 and g &lt; 256 do
    g = g + 1
    local k = readInteger(n - 0x20)
    if k == nil then return nil end
    if k &gt;= key then best = n; n = readQword(n) else n = readQword(n + 0x10) end
  end
  if best and readInteger(best - 0x20) == key then return best end
  return nil
end

local function eachDesc(cb)
  local n = readQword(G(0x1D0B358))
  local stack, guard = {}, 0
  while (n and n ~= 0) or #stack &gt; 0 do
    guard = guard + 1
    if guard &gt; 200000 then break end
    if n and n ~= 0 then
      stack[#stack + 1] = n
      n = readQword(n)
    else
      n = table.remove(stack)
      local key = readInteger(n - 0x20)
      local arr = readQword(n - 0x18)
      local size = readInteger(n - 0x10)
      if arr and size and size &gt; 0 and size &lt; 0x10000 then
        for i = 0, size - 1 do
          local d = readQword(arr + i * 8)
          if d and d ~= 0 then cb(key, i, d) end
        end
      end
      n = readQword(n + 0x10)
    end
  end
end

function WvList()
  local b = getAddress(MOD)
  local cls, order = {}, {}
  eachDesc(function(key, i, d)
    local vt = readQword(d)
    if vt then
      local rva = vt - b
      local c = cls[rva]
      if not c then c = {n = 0, ok = 0, ids = {}, raw = {}}; cls[rva] = c; order[#order + 1] = rva end
      c.n = c.n + 1
      local id = (readInteger(d + 0x58) or 0) &amp; 0xFFFFFFFF
      if (id &amp; 0xFFFF) == i and ((id &gt;&gt; 16) - 2) == key then
        c.ok = c.ok + 1
        if #c.ids &lt; 8 then c.ids[#c.ids + 1] = string.format('%X', id) end
      elseif #c.raw &lt; 3 then
        c.raw[#c.raw + 1] = string.format('key=%d idx=%d id58=%X', key, i, id)
      end
    end
  end)
  table.sort(order)
  for _, rva in ipairs(order) do
    local c = cls[rva]
    print(string.format('vtable +%X%s  total=%d consistent=%d  ids: %s', rva, rva == FIREARM_VT and ' (FIREARM)' or '', c.n, c.ok, table.concat(c.ids, ' ')))
    if c.ok == 0 and #c.raw &gt; 0 then print('   inconsistent samples: ' .. table.concat(c.raw, ' | ')) end
  end
end

function WvEffectHist()
  local h = {}
  eachDesc(function(key, i, d)
    local id = (readInteger(d + 0x58) or 0) &amp; 0xFFFFFFFF
    if (id &amp; 0xFFFF) == i and ((id &gt;&gt; 16) - 2) == key then
      local v = readInteger(d + 0x2B8) or -999
      local vt = (readQword(d) or 0) - getAddress(MOD)
      local k = string.format('vt+%X eff=%d', vt, v)
      h[k] = (h[k] or 0) + 1
    end
  end)
  for k, n in pairs(h) do print(k, n) end
end

function WvFindStr(pat)
  pat = pat:lower()
  local n = 0
  eachDesc(function(key, i, d)
    local id = (readInteger(d + 0x58) or 0) &amp; 0xFFFFFFFF
    if (id &amp; 0xFFFF) ~= i or ((id &gt;&gt; 16) - 2) ~= key then return end
    local bytes = readBytes(d, 0x750, true)
    if not bytes then return end
    for off = 0, 0x748, 8 do
      local p = 0
      for k = 0, 7 do p = p | (bytes[off + k + 1] &lt;&lt; (k * 8)) end
      if p &gt; 0x10000 and p &lt; 0x7FFFFFFFFFFF then
        local s = readString(p, 64)
        if s and s:lower():find(pat, 1, true) then
          n = n + 1
          print(string.format('id %X vt+%X  +%X -&gt; %s', id,
            (readQword(d) or 0) - getAddress(MOD), off, s))
        end
      end
    end
  end)
  print('matches: ' .. n)
end

function WvKeys()
  local cnt = {}
  eachDesc(function(key, i, d) cnt[key] = (cnt[key] or 0) + 1 end)
  local keys = {}
  for k in pairs(cnt) do keys[#keys + 1] = k end
  table.sort(keys)
  for _, k in ipairs(keys) do print(string.format('node key=%d (group %d)  descs=%d', k, k + 2, cnt[k])) end
  print('root ptr = ' .. string.format('%X', readQword(G(0x1D0B358)) or 0))
end

function WvFindEffect(eff)
  local b = getAddress(MOD)
  local n = 0
  eachDesc(function(key, i, d)
    local id = (readInteger(d + 0x58) or 0) &amp; 0xFFFFFFFF
    if (id &amp; 0xFFFF) == i and ((id &gt;&gt; 16) - 2) == key
       and readInteger(d + 0x2B8) == eff then
      n = n + 1
      print(string.format('effect %d: id %X  vt+%X  type %X',
        eff, id, (readQword(d) or 0) - b, descType(d)))
    end
  end)
  print('matches: ' .. n)
end

function WvTypes()
  local b = getAddress(MOD)
  local t, order = {}, {}
  eachDesc(function(key, i, d)
    local id = (readInteger(d + 0x58) or 0) &amp; 0xFFFFFFFF
    if (id &amp; 0xFFFF) == i and ((id &gt;&gt; 16) - 2) == key then
      local ty = descType(d)
      local e = t[ty]
      if not e then
        e = {n = 0, vt = (readQword(d) or 0) - b, ids = {}}
        t[ty] = e
        order[#order + 1] = ty
      end
      e.n = e.n + 1
      if #e.ids &lt; 6 then e.ids[#e.ids + 1] = string.format('%X', id) end
    end
  end)
  table.sort(order)
  for _, ty in ipairs(order) do
    local e = t[ty]
    print(string.format('type %X%s n=%d vt+%X ids: %s', ty, SW[ty] and ' (in switch)' or '', e.n, e.vt, table.concat(e.ids, ' ')))
  end
end

local function firstOfVT(rva)
  local b = getAddress(MOD)
  local found
  eachDesc(function(key, i, d)
    if not found and readQword(d) == b + rva then
      local id = (readInteger(d + 0x58) or 0) &amp; 0xFFFFFFFF
      if (id &amp; 0xFFFF) == i and ((id &gt;&gt; 16) - 2) == key then found = id end
    end
  end)
  return found
end

local function validDesc(desc)
  if not desc or desc &lt; 0x10000 then return false end
  local id = (readInteger(desc + 0x58) or 0) &amp; 0xFFFFFFFF
  local node = findNode((id &gt;&gt; 16) - 2)
  if not node then return false end
  local size = readInteger(node - 0x10) or 0
  local arr = readQword(node - 0x18) or 0
  local idx = id &amp; 0xFFFF
  return arr ~= 0 and idx &lt; size and readQword(arr + idx * 8) == desc
end

local function asItem(p)
  if not p or p &lt; 0x10000 or p &gt; 0x7FFFFFFFFFFF then return nil end
  local desc = readQword(p + 0x60)
  if not validDesc(desc) then return nil end
  local nm = readQword(desc + 0x18)
  return {
    p = p, desc = desc,
    id = (readInteger(desc + 0x58) or 0) &amp; 0xFFFFFFFF,
    vt = (readQword(desc) or 0) - getAddress(MOD),
    ty = descType(desc),
    amt = readInteger(p + 0x40) or -1,
    dur = readFloat(p + 0x44) or 0,
    eff = readInteger(desc + 0x2B8) or -999,
    name = (nm and nm &gt; 0x10000 and readString(nm, 64)) or '?'
  }
end

local function scanArray(ptr, maxn)
  local items, miss = {}, 0
  if not ptr or ptr &lt; 0x10000 or ptr &gt; 0x7FFFFFFFFFFF then return items end
  if not readQword(ptr) and not readQword(ptr + 8) then return items end
  for k = 0, maxn - 1 do
    local q = readQword(ptr + k * 8)
    if q == nil then break end
    local it = asItem(q)
    if it then items[#items + 1] = it; miss = 0
    else miss = miss + 1; if miss &gt; 48 and #items &gt; 0 then break end end
  end
  return items
end

local function printItem(it)
  print(string.format('  item %X id=%X vt+%X type=%X amt=%d dur=%.1f eff=%d  %s',
    it.p, it.id, it.vt, it.ty, it.amt, it.dur, it.eff, it.name))
end

function WvInv(container)
  if not container then
    local mgr = readQword('HUDDIManager')
    if not mgr or mgr == 0 then print('WvInv: HUDDIManager symbol missing - enable "Get Classes" first'); return end
    local pdi = readQword(mgr + 0x780)
    if not pdi or pdi == 0 then print('WvInv: PlayerDI not found'); return end
    container = readQword(pdi + 0x938)
    print(string.format('mgr=%X playerDI=%X container=%X', mgr, pdi, container or 0))
  end
  if not container or container == 0 then print('WvInv: container not found'); return end

  local best, bestOff, seen = nil, nil, {}
  for off = 0, 0x7F8, 8 do
    local v = readQword(container + off)
    local cnt = readInteger(container + off + 8) or 0
    local maxn = (cnt &gt; 0 and cnt &lt; 4096) and (cnt + 16) or 512
    local a = scanArray(v, maxn)
    local b = (#a == 0 and v and v &gt; 0x10000) and scanArray(readQword(v), maxn) or {}
    for _, items in ipairs({a, b}) do
      if #items &gt; 0 then
        print(string.format('container+%X : %d valid items', off, #items))
        if not best or #items &gt; #best then best, bestOff = items, off end
      end
    end
  end
  if not best then print('WvInv: no item arrays found in container (try WvInv(addr) with another object)'); return end
  print(string.format('--- biggest list at container+%X (%d items) ---', bestOff, #best))
  for _, it in ipairs(best) do printItem(it) end
end

local function quickArray(ptr, maxn)
  local items = {}
  if not ptr or ptr &lt; 0x10000 or ptr &gt; 0x7FFFFFFFFFFF then return items end
  local hit = 0
  for k = 0, 15 do
    local q = readQword(ptr + k * 8)
    if q == nil then return items end
    if asItem(q) then hit = hit + 1 end
  end
  if hit == 0 then return items end
  local miss = 0
  for k = 0, (maxn or 1024) - 1 do
    local q = readQword(ptr + k * 8)
    if q == nil then break end
    local it = asItem(q)
    if it then items[#items + 1] = it; miss = 0
    else miss = miss + 1; if miss &gt; 48 then break end end
  end
  return items
end

function WvInvDeep(container, maxDepth)
  if not container then
    local mgr = readQword('HUDDIManager')
    local pdi = mgr and readQword(mgr + 0x780)
    container = pdi and readQword(pdi + 0x938)
  end
  if not container or container == 0 then print('WvInvDeep: container not found'); return end
  maxDepth = maxDepth or 3
  local base = getAddress(MOD)
  local visited, lists, all, allN = {}, {}, {}, 0

  local function isObj(p)
    if not p or p &lt; 0x10000 or p &gt; 0x7FFFFFFFFFFF then return false end
    local vt = readQword(p)
    return vt ~= nil and vt &gt;= base and vt &lt; base + 0x2400000
  end

  local function walk(obj, depth, path)
    for off = 0, 0x200, 8 do
      local v = readQword(obj + off)
      if v and v &gt; 0x10000 and v &lt; 0x7FFFFFFFFFFF and not visited[v] then
        visited[v] = true
        local items = quickArray(v)
        if #items == 0 then items = quickArray(readQword(v)) end
        local p2 = string.format('%s+%X', path, off)
        if #items &gt; 0 then
          lists[#lists + 1] = {path = p2, items = items}
          for _, it in ipairs(items) do
            if not all[it.p] then all[it.p] = it; allN = allN + 1 end
          end
        elseif depth &gt; 0 and isObj(v) then
          walk(v, depth - 1, p2 .. '&gt;')
        end
      end
    end
  end

  visited[container] = true
  walk(container, maxDepth, 'inv')
  for _, l in ipairs(lists) do print(string.format('%s : %d items', l.path, #l.items)) end
  print(string.format('--- %d unique items across %d lists ---', allN, #lists))
  local sorted = {}
  for _, it in pairs(all) do sorted[#sorted + 1] = it end
  table.sort(sorted, function(a, b) return a.id &lt; b.id end)
  for _, it in ipairs(sorted) do printItem(it) end
end

-- dump every string a desc points to, to identify an item by its internal names
function WvDescStrings(id)
  id = id &amp; 0xFFFFFFFF
  local node = findNode((id &gt;&gt; 16) - 2)
  if not node then print('no node'); return end
  local arr = readQword(node - 0x18) or 0
  local d = readQword(arr + (id &amp; 0xFFFF) * 8)
  if not d or d == 0 then print('no desc'); return end
  for off = 0, 0x748, 8 do
    local p = readQword(d + off)
    if p and p &gt; 0x10000 and p &lt; 0x7FFFFFFFFFFF then
      local s = readString(p, 64)
      if s and #s &gt;= 3 and s:match('^[%w_%.%-&amp;: /]+$') then
        print(string.format('desc+%X -&gt; %s', off, s))
      end
    end
  end
end

function WvRegister(srcId, real)
  if readInteger('WvState') == nil then
    print('v5: enable the hook entry first')
    return
  end

  if srcId == nil then srcId = readInteger('WvSrcId') end
  srcId = (srcId or 0) &amp; 0xFFFFFFFF

  if srcId == 0 then
    srcId = firstOfVT(FIREARM_VT)
    if not srcId then
      print('v5: no consistent firearm desc found - run WvList(), set Source item id, register again')
      return
    end
    print(string.format('v5: auto source id %X', srcId))
  end

  local group = srcId &gt;&gt; 16
  local idx = srcId &amp; 0xFFFF
  local node = findNode(group - 2)

  if not node then
    print(string.format('v5: no node with key %d for id %X - run WvKeys() / WvList()', group - 2, srcId))
    return
  end

  local size = readInteger(node - 0x10)
  local arr = readQword(node - 0x18)

  if not size or not arr or arr == 0 or idx &gt;= size then
    print('v5: index out of range')
    return
  end

  if size &gt;= 0xFFFF then
    print('v5: group array full')
    return
  end

  local src = readQword(arr + idx * 8)
  if not src or src == 0 then
    print('v5: empty slot')
    return
  end

  if ((readInteger(src + 0x58) or 0) &amp; 0xFFFFFFFF) ~= srcId then
    print('v5: desc id mismatch, aborting')
    return
  end

  local clone, newArr, newId, newCount

  if real then
    clone, newArr, newId, newCount = src, arr, srcId, size
  else
    clone = gmalloc(DESC_SIZE + 8)

    local bytes = readBytes(src, DESC_SIZE, true)
    if not bytes then
      bytes = {}
      for q = 0, DESC_SIZE // 8 - 1 do
        local v = readQword(src + q * 8) or 0
        for k = 0, 7 do
          bytes[q * 8 + k + 1] = (v &gt;&gt; (k * 8)) &amp; 0xFF
        end
      end
    end
    writeBytes(clone, bytes)

    newArr = gmalloc((size + 0x101) * 8)
    local old = readBytes(arr, size * 8, true)
    if not old then
      print('v5: could not read old array')
      return
    end

    writeBytes(newArr, old)
    writeQword(newArr + size * 8, clone)
    newId = (srcId &amp; 0xFFFF0000) | size
    writeInteger(clone + 0x58, newId)
    newCount = size + 1
  end

  local gl = readQword(G(GETLEVEL_IAT)) or 0
  writeQword('WvGetLevel', gl)
  writeQword('WvIgs', 0)
  writeInteger('WvIgsMode', 0)
  writeInteger('WvNullCount', 0)
  writeInteger('WvBuildOK', 0)
  writeInteger('WvSpawned', 0)

  writeQword('WvNode', node)
  writeQword('WvDescNew', clone)
  writeQword('WvArrNew', newArr)
  writeInteger('WvNewCount', newCount)
  writeInteger('WvNewId', newId)
  writeInteger('WvState', 1)

  print(string.format(
    'v5: %s %X -&gt; %X, desc at %X, GetLevel=%X. Hook publishes it + builds the instance on the next game tick (WvStage becomes 4).',
    real and 'REAL' or 'cloned', srcId, newId, clone, gl
  ))
end

function WvInfo()
  print('--- WvInfo v5.2 ---')

  local function rd(n) return readInteger(n) or -1 end
  local function rq(n) return readQword(n) or 0 end

  print(string.format(
    'Stage=%d State=%d BuildOK=%d Spawned=%d Nulls=%d IgsMode=%d',
    rd('WvStage'), rd('WvState'), rd('WvBuildOK'),
    rd('WvSpawned'), rd('WvNullCount'), rd('WvIgsMode')
  ))

  print(string.format(
    'NewId=%X cloneDesc=%X instDesc=%X inst+90=%X lastObj=%X',
    rd('WvNewId') &amp; 0xFFFFFFFF,
    rq('WvDescNew'),
    rq('WvInstDesc'),
    rd('WvInst90') &amp; 0xFFFFFFFF,
    rq('WvLastObj')
  ))

  local op = getAddress('WvObjPos')
  local gg = readQword(G(0x1C16348)) or 0
  local a = gg ~= 0 and readQword(gg + 0x540) or 0
  local b2 = a ~= 0 and readQword(a + 0xB8) or 0
  local pl = b2 ~= 0 and readQword(b2 + 0x58) or 0

  if pl ~= 0 then
    local px = readFloat(pl + 0x808) or 0
    local py = readFloat(pl + 0x80C) or 0
    local pz = readFloat(pl + 0x810) or 0
    local ox = readFloat(op) or 0
    local oy = readFloat(op + 4) or 0
    local oz = readFloat(op + 8) or 0

    print(string.format(
      'player pos = %.2f %.2f %.2f   dist to object = %.2f',
      px, py, pz, math.sqrt((px - ox) ^ 2 + (py - oy) ^ 2 + (pz - oz) ^ 2)
    ))
  else
    print(string.format('player not found (G=%X a=%X b=%X)', gg, a, b2))
  end

  print(string.format(
    'object pos = %.2f %.2f %.2f',
    readFloat(op) or 0,
    readFloat(op + 4) or 0,
    readFloat(op + 8) or 0
  ))

  local pp = getAddress('WvPlyPos')
  print(string.format(
    'spawn base pos = %.2f %.2f %.2f  (engine path flag %d: 0 = +808, 1 = engine pos, 2 = engine pos+fwd)',
    readFloat(pp) or 0,
    readFloat(pp + 4) or 0,
    readFloat(pp + 8) or 0,
    rd('WvPlyOK')
  ))

  local lo = rq('WvLastObj')
  if lo ~= 0 then
    local vt = readQword(lo) or 0
    print('object vtable = ' .. tostring(getNameFromAddress(vt)))

    local s = {}
    for k = 0, 8 do
      s[#s + 1] = string.format('%X', readQword(lo + 0x18 + k * 8) or 0)
    end
    print('object +18..: ' .. table.concat(s, ' '))
  end

  local ib = getAddress('WvInstBuf')
  local t = {}
  for k = 0, 0x17 do
    t[#t + 1] = string.format('%X:%X', k * 8, readQword(ib + k * 8) or 0)
  end
  print('inst: ' .. table.concat(t, ' '))

  print(string.format(
    'clone+58=%X clone+78=%X src-ish',
    readInteger((rq('WvDescNew') or 0) + 0x58) or 0,
    readInteger((rq('WvDescNew') or 0) + 0x78) or 0
  ))

  local id = rd('WvNewId') &amp; 0xFFFFFFFF
  local node = findNode((id &gt;&gt; 16) - 2)

  if node then
    local size = readInteger(node - 0x10) or 0
    local arr = readQword(node - 0x18) or 0
    local d = (id &amp; 0xFFFF) &lt; size and readQword(arr + (id &amp; 0xFFFF) * 8) or 0

    print(string.format(
      'registry lookup of %X: size=%d desc=%X (%s)',
      id, size, d,
      d == rq('WvDescNew') and 'matches clone' or 'DOES NOT match clone'
    ))
  else
    print('registry: node for new id not found')
  end
end

if WvHK0 then pcall(function() WvHK0.destroy() end) end
if WvHK1 then pcall(function() WvHK1.destroy() end) end
if WvHK2 then pcall(function() WvHK2.destroy() end) end
if WvHK3 then pcall(function() WvHK3.destroy() end) end
if WvHK4 then pcall(function() WvHK4.destroy() end) end
if WvHK5 then pcall(function() WvHK5.destroy() end) end

WvHK0 = createHotkey(function() WvInfo() end, VK_F7)
WvHK4 = createHotkey(function() WvTypes() end, VK_F6)
WvHK3 = createHotkey(function() WvRegister(nil, true) end, VK_F8)
WvHK1 = createHotkey(function() WvRegister() end, VK_F9)
WvHK2 = createHotkey(function()
  if readInteger('WvReq') ~= nil then
    writeInteger('WvReq', 1)
  end
end, VK_F10)
WvHK5 = createHotkey(function() WvInvDeep() end, VK_F5)
</LuaScript>
</CheatTable>
