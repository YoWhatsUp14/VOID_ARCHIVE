              <AssemblerScript>[ENABLE]
aobscanmodule(ItemReplace,gamedll_x64_rwdi.dll,8B 01 48 8B D9 39)
alloc(AC_Enabled,$4,ItemReplace)
alloc(AC_SafeId,$4,ItemReplace)
alloc(AC_LastGood,$4,ItemReplace)
alloc(AC_LastBlocked,$4,ItemReplace)
alloc(AC_BlockCount,$4,ItemReplace)
alloc(AC_Ranges,$400,ItemReplace)
alloc(AC_Mem,$200,ItemReplace)
registersymbol(ItemReplace)
registersymbol(AC_Enabled)
registersymbol(AC_SafeId)
registersymbol(AC_LastBlocked)
registersymbol(AC_BlockCount)

AC_Enabled:
  dd 1
AC_SafeId:
  dd 0
AC_LastGood:
  dd 0
AC_LastBlocked:
  dd 0
AC_BlockCount:
  dd 0

AC_Ranges:
  dd 50000 50003
  dd 60000 60003
  dd 70000 70003
  dd 80000 80003
  dd 90000 90003
  dd A0000 A0003
  dd 120001 120001
  dd 200000 200005
  dd 210000 210001
  dd 220000 22000F
  dd 260000 260000
  dd 270000 270009
  dd 280000 280009
  dd 2C0000 2C0008
  dd 2D0000 2D0008
  dd 2E0000 2E0002
  dd 2F0000 2F0009
  dd 300000 300002
  dd 310000 310008
  dd 320000 32000D
  dd 330000 33000D
  dd 330015 3300B1
  dd 3300B3 3300B3
  dd 3300B8 3300C4
  dd 340000 340009
  dd 350000 35000B
  dd 370000 370006
  dd 390000 390013
  dd 3A0000 3A0000
  dd 3B0000 3B0000
  dd 3B0007 3B0007
  dd 3C0000 3C0001
  dd 3D0000 3D0007
  dd 3E0000 3E0001
  dd 3F0000 3F000D
  dd 400000 400011
  dd 420000 42000E
  dd 430000 430004
  dd 0 0

label(AC_Loop)
label(AC_Good)
label(AC_Bad)
label(AC_Write)
label(AC_Original)

AC_Mem:
  cmp dword ptr [AC_Enabled],0
  je AC_Original
  mov eax,[rcx]
  cmp eax,C64
  jbe AC_Original
  push rdx
  lea rdx,[AC_Ranges]
AC_Loop:
  cmp dword ptr [rdx],0
  je AC_Bad
  cmp eax,[rdx]
  jb AC_Bad
  cmp eax,[rdx+4]
  jbe AC_Good
  add rdx,8
  jmp AC_Loop

AC_Good:
  pop rdx
  mov [AC_LastGood],eax
  mov rbx,rcx
  jmp ItemReplace+5

AC_Bad:
  pop rdx
  mov [AC_LastBlocked],eax
  inc dword ptr [AC_BlockCount]
  mov eax,[AC_SafeId]
  test eax,eax
  jnz AC_Write
  mov eax,[AC_LastGood]
AC_Write:
  mov [rcx],eax
  mov rbx,rcx
  jmp ItemReplace+5

AC_Original:
  mov eax,[rcx]
  mov rbx,rcx
  jmp ItemReplace+5

ItemReplace:
  jmp AC_Mem

[DISABLE]
ItemReplace:
  db 8B 01 48 8B D9
unregistersymbol(AC_Enabled)
unregistersymbol(AC_SafeId)
unregistersymbol(AC_LastBlocked)
unregistersymbol(AC_BlockCount)
unregistersymbol(ItemReplace)
dealloc(AC_Enabled)
dealloc(AC_SafeId)
dealloc(AC_LastGood)
dealloc(AC_LastBlocked)
dealloc(AC_BlockCount)
dealloc(AC_Ranges)
dealloc(AC_Mem)
</AssemblerScript>
