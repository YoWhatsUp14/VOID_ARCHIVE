                  <AssemblerScript>[ENABLE]
// The lobby list filter (0 All, 1 Nearest, 2 Friends, 3 LastMeet) lives at [[game+8F8]+358].
// A timer keeps it at 0. No window, just a background timer.
{$lua}
if syntaxcheck then return end
local base = getAddress("gamedll_x64_rwdi.dll") + 0x1C16348
if LobbyFilterTimer then LobbyFilterTimer.destroy() LobbyFilterTimer = nil end
LobbyFilterTimer = createTimer(nil)
LobbyFilterTimer.Interval = 250
LobbyFilterTimer.OnTimer = function(t)
  local p = readPointer(base)
  if p == nil or p == 0 then return end
  local s = readPointer(p + 0x8F8)
  if s == nil or s == 0 then return end
  if readInteger(s + 0x358) ~= 0 then writeInteger(s + 0x358, 0) end
end

[DISABLE]
