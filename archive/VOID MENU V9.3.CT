              <AssemblerScript>[ENABLE]
aobscanmodule(INJECT,gamedll_x64_rwdi.dll,83 BB 90 02 00 00 05 74 04 B3 01 EB 02 32 DB)
alloc(newmem,$1000,INJECT)

newmem:
  // ГАРАНТИРОВАННЫЙ ТАКЛ:
  // 1) Форсим push-состояние независимо от dodge
  mov dword ptr [rbx+00000298],2

  // 2) Эмулируем «равно» ветку (как если бы cmp == 5), т.е. bl = 0
  xor bl,bl

  // 3) Возврат ПОВЕРХ всего старого блока (15 байт)
  jmp INJECT+0F

INJECT:
  jmp newmem
  // Затираем оставшиеся 10 байт блока NOP'ами (всего блок = 15 байт)
  db 90 90 90 90 90 90 90 90 90 90

registersymbol(INJECT)

[DISABLE]
