    <CheatEntry>
      <ID>1337310697</ID>
      <Description>"Player Variables"</Description>
      <Options moHideChildren="1"/>
      <LastState Value="" RealAddress="00000000"/>
      <Color>40FF00</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>223</ID>
          <Description>"Hook GetFloatVar (ENABLE FIRST)"</Description>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(PVHook,gamedll_x64_rwdi.dll,48 8B 01 4C 63 C2 4E 8B 0C C0 8D 82 97 FD FF FF 83 F8 29 77)
alloc(PVMem,$2000,PVHook)
label(PVOrig)
label(PVRet)
label(PVDone)
label(pVars)
label(PVMul)
registersymbol(PVHook)
registersymbol(pVars)
registersymbol(PVMul)

PVMem:
  mov [pVars],rcx
  sub rsp,28
  mov [rsp+20],edx
  call PVOrig
  mov edx,[rsp+20]
  add rsp,28
  cmp edx,412
  jae PVDone
  movsxd rdx,edx
  lea rax,[PVMul]
  movss xmm1,[rax+rdx*4]
  xorps xmm2,xmm2
  ucomiss xmm1,xmm2
  je PVDone
  mulss xmm0,xmm1
PVDone:
  ret
PVOrig:
  mov rax,[rcx]
  movsxd r8,edx
  jmp PVRet

PVMem+100:
pVars:
  dq 0
PVMem+200:
PVMul:
  dd 0

PVHook:
  jmp PVMem
  nop
PVRet:

[DISABLE]
PVHook:
  db 48 8B 01 4C 63 C2
unregistersymbol(PVHook)
unregistersymbol(pVars)
unregistersymbol(PVMul)
dealloc(PVMem)
</AssemblerScript>
