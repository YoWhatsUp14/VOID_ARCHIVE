  // ВОССТАНОВЛЕНИЕ исходных 15 байт:
  // cmp dword ptr [rbx+00000290],05
  // je  +04
  // mov bl,01
  // jmp +02
  // xor bl,bl
  db 83 BB 90 02 00 00 05
  db 74 04
  db B3 01
  db EB 02
  db 32 DB

unregistersymbol(INJECT)
dealloc(newmem)

</AssemblerScript>
