        <CheatEntry>
          <ID>225</ID>
          <Description>"Bool unlock pack (forces parkour/sense/stealth bool vars ON every 200ms)"</Description>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local ids = {991,916,917,1023,935,937,999,958,1004,1005,971,931,961,962,973,994,995,908,909,955,1026,1027,1015,1016,939,940,941,963,964,902,996,997,1006}
if PVBoolTimer then PVBoolTimer.destroy() PVBoolTimer = nil end
PVBoolTimer = createTimer(nil)
PVBoolTimer.Interval = 200
PVBoolTimer.OnTimer = function(t)
  local c = readPointer(getAddress("pVars"))
  if c == nil or c == 0 then return end
  local arr = readPointer(c)
  if arr == nil or arr == 0 then return end
  for _, id in ipairs(ids) do
    local v = readPointer(arr + id * 8)
    if v ~= nil and v ~= 0 then
      local b = readBytes(v + 8, 1, false)
      if b ~= nil and (b % 4) ~= 3 then writeBytes(v + 8, b - (b % 4) + 3) end
    end
  end
end

[DISABLE]
{$lua}
if syntaxcheck then return end
if PVBoolTimer then PVBoolTimer.destroy() PVBoolTimer = nil end
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
