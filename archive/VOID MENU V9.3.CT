  mov [HiveC_G],(float)-128
  mov [HiveC_B],(float)0
  jmp code
cyan:
  mov [HiveC_R],(float)0
  mov [HiveC_G],(float)-255
  mov [HiveC_B],(float)-255
  jmp code
blue:
  mov [HiveC_R],(float)0
  mov [HiveC_G],(float)0
  mov [HiveC_B],(float)-155
  jmp code
purple:
  mov [HiveC_R],(float)-128
  mov [HiveC_G],(float)0
  mov [HiveC_B],(float)-128
  jmp code
white:
  mov [HiveC_R],(float)-255
  mov [HiveC_G],(float)1
  mov [HiveC_B],(float)1
  jmp code

code:
  add [sleepTime],1
  //--R
  mov eax,[HiveC_R]
  mov [rbx+rcx*8+28],eax
  //--G
  mov eax,[HiveC_G]
  mov [rbx+rcx*8+2C],eax
  //--B
